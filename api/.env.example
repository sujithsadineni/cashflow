# Copy to api/.env and adjust. api/.env is git-ignored — never commit it.

# Postgres connection. With a default Homebrew/Postgres.app install this
# connects as your OS user with no password.
DATABASE_URL=postgres://localhost:5432/cashflow

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Optional. Without it, CSV imports and the built-in PDF parsers (Bank of
# America, Chase, American Express, Bilt) still work; other banks' PDFs and
# AI category suggestions need a key from https://console.anthropic.com.
ANTHROPIC_API_KEY=

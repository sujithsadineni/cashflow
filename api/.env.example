# Copy to api/.env and adjust. api/.env is git-ignored — never commit it.

# Postgres connection. With a default Homebrew/Postgres.app install this
# connects as your OS user with no password.
DATABASE_URL=postgres://localhost:5432/cashflow

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Optional. Without it, CSV imports and the free PDF readers (Bank of America,
# Chase, American Express, Bilt, Robinhood, Barclays, SoFi, Apple Card, Zolve)
# still work. Another bank's PDF can be read by Claude, one file at a time and
# only when you click "Read with Claude"; that needs a key from
# https://console.anthropic.com.
ANTHROPIC_API_KEY=

# Optional. Daily backups (database + statements) go here; default
# ~/cashflow-backups. BACKUP_SCHEDULE=off turns the daily backup off (a
# throwaway API, like the demo recorder's); Settings → Backups still works.
# BACKUP_DIR=
# BACKUP_SCHEDULE=
